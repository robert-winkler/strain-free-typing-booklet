@book{rojas_gualdron_proteccion_2020,
	title = {Protección de la salud mental de los trabajadores de salud en la primera línea de atención de la pandemia de {COVID}-19: una revisión sistemática rápida},
	shorttitle = {Protección de la salud mental de los trabajadores de salud en la primera línea de atención de la pandemia de {COVID}-19},
	abstract = {Resumen
Introducción. Los riesgos a los que se exponen los trabajadores de la salud en primera línea de atención del COVID-19 exceden el contagio. Se deben implementar estrategias integrales de cuidado, incluyendo la protección de su salud mental.
Objetivo. Analizar mediante revisión sistemática la evidencia disponible sobre salud mental de los trabajadores de la salud en primera línea de atención del COVID-19.
Materiales y métodos. Revisión sistemática de la literatura. Se buscaron artículos en Pubmed, Scopus y LILACS, sin restricción de idioma o tipo de publicación. Dos lectores realizaron lectura, extracción y valoración crítica mediante herramientas del Joanna Briggs Institute. Se realizó síntesis narrativa.
Resultados. De 306 registros identificados se incluyeron 14 artículos de correspondencia y 13 artículos originales. Se excluyeron cinco originales por valoración crítica. La evidencia reporta situaciones de riesgo intrínsecas (miedo, preocupación, aparición de síntomas mentales, desesperanza) y extrínsecas (trabajo y comportamiento suicida) que se dan en el entorno laboral, familiar y social. Se presenta un inventario de propuestas de estrategias individuales y organizacionales de prevención. Las afectaciones más frecuentes reportadas en los estudios transversales son miedo y angustia.
Conclusión. Personal e instituciones de salud deben reconocer e implementar estrategias activas y rutinarias de prevención de daño a la salud mental. Esto se debe hacer en un ambiente libre de estigma y con focalización en personas que presentan los factores asociados a mayor afectación. La evidencia caracteriza principalmente las semanas anteriores a la declaración de la pandemia en China y deberá ser actualizada periódicamente.},
	author = {Rojas Gualdrón, Diego and Márquez, Melisa and Gallego, David and Palacio, Valentina and Orozco, Susana and Velázquez, Natalia and Palacios, Uriel and Bernal, Andres and Bernal, Diana},
	month = jun,
	year = {2020},
}

@article{samaniego_sintomatologiasociada_2020,
	title = {Sintomatología asociada a trastornos de {Salud} {Mental} en trabajadores sanitarios en {Paraguay}: efecto {COVID}-19},
	volume = {54},
	issn = {2329-4795, 0034-9690},
	shorttitle = {Sintomatología asociada a trastornos de {Salud} {Mental} en trabajadores sanitarios en {Paraguay}},
	url = {https://journal.sipsych.org/index.php/IJP/article/view/1298},
	doi = {10.30849/ripijp.v54i1.1298},
	abstract = {La enfermedad por COVID-19 no solo ha provocado un colapso del sistema sanitario y la muerte de miles de personas, sino que está repercutiendo en la salud de las personas que están brindando atención a los infectados.  En este marco, el objetivo de esta investigación fue determinar prevalencias de depresión, ansiedad, insomnio, distrés y fatiga por compasión, así como factores relacionados a la presencia de sintomatología asociada a estos trastornos en profesionales de los equipos de salud. Para esto, se encuestó en formato online a 126 profesionales sanitarios del Paraguay, de los cuales el 83\% son mujeres, con una edad promedio en la muestra total de 32 años. Se aplicaron los cuestionarios PHQ-9 para depresión, GAD-7 para ansiedad, ISI-7 para insomnio, IES-R para distrés y el módulo de fatiga por compasión del ProQOL – CSF-vIV. Se encuentra que los porcentajes de participantes que reportaron síntomas clasificables como moderados y severos fueron de un 32.2\% para depresión, 41.3\% en ansiedad, 27.8\% en insomnio, 38.9\% en distrés y un 64.3\% en fatiga por compasión. Adicionalmente las mujeres y los de menor edad presentaron un riesgo mayor de presentar síntomas. Los datos aportan evidencia a la necesidad de establecer estrategias de prevención o intervención para abordar los problemas de salud mental en los profesionales de la salud.},
	number = {1},
	urldate = {2021-02-19},
	journal = {RIP/IJP},
	author = {Samaniego, Antonio and Urzúa, Alfonso and Buenahora, Marcelo and Vera-Villarroel, Pablo},
	month = may,
	year = {2020},
	pages = {e1298},
}

@article{lozano-vargas_impacto_2020,
	title = {Impacto de la epidemia del {Coronavirus} ({COVID}-19) en la salud mental del personal de salud y en la población general de {China}},
	volume = {83},
	issn = {0034-8597},
	doi = {10.20453/rnp.v83i1.3687},
	abstract = {ResumenEn la lucha contra la epidemia del Coronavirus (COVID-19), el personal de salud puede experimentar problemas de salud mental tales como estrés, ansiedad, síntomas depresivos, insomnio, negación, ira y temor. En un estudio en China se observó que la tasa de ansiedad del personal de salud fue del 23,04\%, mayor en mujeres que en hombres y mayor entre las enfermeras que entre los médicos. Asimismo, en la población general de China se observó un 53,8\% de impacto psicológico moderado a severo; un 16,5\% de síntomas depresivos, un 28,8\% de síntomas ansiosos y un 8,1\% de estrés, todos entre moderados y severos. Los factores asociados con un alto impacto psicológico y niveles elevados de estrés, síntomas de ansiedad y depresión fueron sexo femenino, ser estudiante, tener síntomas físicos específicos y una percepción pobre de la propia salud. Otro estudio en el mismo país detectó un 35\% de distrés psicológico en la población general, con las mujeres presentando mayores niveles que los varones, al igual que los sub-grupos de 18-30 años y los mayores de 60 años. La pandemia plantea pues el desafío de cuidar la salud mental del personal de salud tanto como la de la población general. Así, el uso de instrumentos breves de detección de problemas de salud mental, validados en nuestra población, sería de mucha utilidad para los retos de salud pública que afronta el país.Palabras-clave: Coronavirus; COVID-19; epidemia; impacto psicológico; salud mental; psiquiatría; estrés; ansiedad; depresión},
	number = {1},
	urldate = {2021-02-19},
	journal = {Revista de Neuro-Psiquiatría},
	author = {Lozano-Vargas, Antonio and Lozano-Vargas, Antonio},
	month = jan,
	year = {2020},
	pages = {51--56},
}

@article{urzua_salud_2020,
	title = {Salud mental en trabajadores de la salud durante la pandemia por {COVID}-19 en {Chile}},
	volume = {148},
	issn = {0034-9887},
	url = {https://scielo.conicyt.cl/scielo.php?script=sci_abstract&pid=S0034-98872020000801121&lng=es&nrm=iso&tlng=es},
	doi = {10.4067/S0034-98872020000801121},
	number = {8},
