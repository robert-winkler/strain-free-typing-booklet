	pmid = {25631240},
	pmcid = {PMC4506239},
	keywords = {Mass Spectrometry, Bioinformatics},
	pages = {745--754},
	file = {Full Text PDF:/home/rob/Zotero/storage/RKQ2BMVN/Deutsch et al. - 2015 - Trans-Proteomic Pipeline, a standardized data proc.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/6T58HI59/full.html:text/html},
}

