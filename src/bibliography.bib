	pmcid = {PMC10395131},
	pages = {1169675},
	file = {PubMed Central Full Text PDF:/home/rob/Zotero/storage/892KPSI5/Sánchez-Velázquez et al. - 2023 - Nutritional, bioactive components and health prope.pdf:application/pdf},
}

