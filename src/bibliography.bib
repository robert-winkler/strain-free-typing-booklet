	month = jun,
	year = {2015},
	pages = {e06793},
	file = {Full Text PDF:/home/rob/Zotero/storage/9VE6PXDT/Markow - 2015 - The secret lives of Drosophila flies.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/J648KFG3/e06793.html:text/html},
}

