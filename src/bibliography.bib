	keywords = {Humans, Zea mays, Animals, Flavonoids, Antioxidants, antioxidant, cereals, Edible Grain, Functional Food, Hordeum, Oryza, Phenolic compounds, Phenols, reactive oxygen species, Triticum},
	pages = {25--35},
}

