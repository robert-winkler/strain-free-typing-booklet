	pages = {22--34},
	file = {ScienceDirect Full Text PDF:/home/rob/Zotero/storage/UJNNDCTA/Nemes and Vertes - 2012 - Ambient mass spectrometry for in vivo local analys.pdf:application/pdf;ScienceDirect Snapshot:/home/rob/Zotero/storage/V28KTB7U/S0165993612000350.html:text/html},
