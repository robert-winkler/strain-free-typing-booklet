	month = aug,
	year = {2011},
	pmid = {21706093},
	keywords = {Mass Spectrometry, Bacterial Typing Techniques, Cold Temperature, bacteria, Esters, Fatty Acids, Principal Component Analysis},
	pages = {3091--3097},
}

