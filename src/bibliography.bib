	keywords = {Mass spectrometry imaging, Atmospheric pressure MALDI MS, Matrix assisted laser desorption ionisation mass spectrometry, Plasma assisted ionisation, Transmission mode MALDI MS},
	file = {ScienceDirect Full Text PDF:/home/rob/Zotero/storage/M3RXM243/Steven et al. - 2018 - Construction and testing of an atmospheric-pressur.pdf:application/pdf;ScienceDirect Snapshot:/home/rob/Zotero/storage/4EICM6M8/S0003267018313308.html:text/html},
