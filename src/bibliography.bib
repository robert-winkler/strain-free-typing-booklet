	journal = {Chem Phys Lipids},
	author = {Sparvero, L.J. and Amoscato, A.A. and Dixon, C.E. and Long, J.B. and Kochanek, P.M. and Pitt, B.R. and Bayir, H. and Kagan, V.E.},
	month = jul,
