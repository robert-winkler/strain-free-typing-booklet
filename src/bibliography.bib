}

@article{cocovi-solberg_opportunities_2018,
	title = {Opportunities for {3D} printed millifluidic platforms incorporating on-line sample handling and separation},
	volume = {108},
	issn = {0165-9936},
	url = {http://www.sciencedirect.com/science/article/pii/S0165993618303005},
	doi = {10.1016/j.trac.2018.08.007},
	abstract = {3D printing is an emerging enabling technology that can facilitate the production of complex 3D structures in analytical chemistry, including the millifluidic, e.g. flow injection (FI), and microfluidic arenas. In this review, the potential of 3D printing for the fabrication of cost-effective millifluidic platforms incorporating on-line sample handling and separation is critically appraised against traditional configurations or manufacturing processes. Applications resorting to structures achievable with 3D printing, in some instances exploiting the surface chemistry of the printable material, are grouped under: (i) fluidic drivers, mixers and reactors, (ii) membrane separation, (iii) sorbent extraction/concentration, (iv) chromatographic and electrophoretic separation, and (v) sensing and detector housings. Summary tables are also presented for reported applications of on-line sample handling and separation in environmental and biochemical analysis.},
	language = {en},
	urldate = {2020-10-29},
	journal = {TrAC Trends in Analytical Chemistry},
	author = {Cocovi-Solberg, David J. and Worsfold, Paul J. and Miró, Manuel},
	month = nov,
	year = {2018},
	keywords = {3D printing, Chromatography, Electrophoresis, Detector housing, Flow injection, Membrane separation, Millifluidic platforms, On-line mixing, Sorptive extraction},
	pages = {13--22},
	file = {ScienceDirect Snapshot:/home/rob/Zotero/storage/W85LR8C9/S0165993618303005.html:text/html},
}

@article{calderilla_recent_2018,
	title = {Recent advances in flow-based automated solid-phase extraction},
	volume = {108},
	issn = {0165-9936},
	url = {http://www.sciencedirect.com/science/article/pii/S0165993618303868},
	doi = {10.1016/j.trac.2018.09.011},
	abstract = {Automated flow-based solid-phase extraction (SPE) is an advantageous tool for analytical sample pretreatment, and the development of novel materials and fabrication techniques to build improved SPE devices are crucial to further advance the field. Additive manufacturing (3D printing) is offering tremendous advantages in comparison with conventional manufacturing techniques, enabling the fast and efficient fabrication of complex SPE devices. In addition, novel materials, and less conventional SPE supports, have also emerged as interesting alternatives for automated SPE, such as magnetic particles, stirred extraction devices, membranes/disks and monolithic supports. In this review, the advantages, limitations and future directions of 3D printing and novel materials and devices for automated flow-based SPE are discussed, highlighting recently developed applications.},
	language = {en},
