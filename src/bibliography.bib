	note = {Publisher: American Association for the Advancement of Science
Section: Research Article},
	keywords = {Humans, Mass Spectrometry, Animals, Female, Principal Component Analysis, Disease Models, Animal, Organ Specificity, Intraoperative Care, Mice, Nude, Molecular Diagnostic Techniques, Neoplasms},
	file = {Full Text PDF:/home/rob/Zotero/storage/58CDNLR7/Zhang et al. - 2017 - Nondestructive tissue analysis for ex vivo and in .pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/JRUDTTAP/eaan3968.html:text/html},
