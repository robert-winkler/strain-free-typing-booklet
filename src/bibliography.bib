	year = {2017},
	note = {\_eprint: https://setac.onlinelibrary.wiley.com/doi/pdf/10.1002/etc.3626},
	keywords = {Emerging contaminants, Bioaccumulation, Biomagnification, Freshwater, Latin America, Marine},
	pages = {1716--1727},
	file = {Full Text PDF:/home/rob/Zotero/storage/5RVKPYLF/Llorca et al. - 2017 - Review of emerging contaminants in aquatic biota f.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/YAUVNQZA/etc.html:text/html},
