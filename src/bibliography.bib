@article{selmar_storage_2008,
	title = {The storage of green coffee ({Coffea} arabica): {Decrease} of viability and changes of potential aroma precursors},
	volume = {101},
	issn = {03057364},
	doi = {10.1093/aob/mcm277},
	abstract = {BACKGROUND AND AIMS: When green coffee is stored for a prolonged time the coffee quality decreases distinctively. Apart from well-known 'off-notes' that arise from undesired oxidations of lipids, a typical 'flattening' of the cup quality is detectable. In order to elucidate the biological causes for this phenomenon, differentially processed coffees (wet, dry, semi-dry processing), were stored under standard conditions for 2 years and analysed comprehensively.\${\textbackslash}backslash\$n\${\textbackslash}backslash\$nMETHODS: Wet-processed coffee was stored either as parchment coffee, where the endocarp remained around the beans or as hulled beans. Viability of coffee seeds was estimated using the tetrazolium-test of seed viability. Changes in concentration of free amino acids and soluble carbohydrates were analysed by HPLC.\${\textbackslash}backslash\$n\${\textbackslash}backslash\$nKEY RESULTS: Whereas all other coffees lost viability within the first 6 months of storage, coffee beans stored within the parchment remained viable for {\textbackslash}textgreater1 year. Glucose and fructose decreased slightly in the course of storage and glutamine content declined significantly. However, the changes observed in sugar and amino acid content were not correlated with the viability of the coffee beans. Consequently, neither typical metabolic reactions occurring within living cells nor characteristic post-mortem reactions could be responsible for the observed changes. As a result of post-mortem reactions in re-imbibed seeds, a characteristic bluish-green colour developed, putatively due to the oxidation of chlorogenic acids and subsequent reactions with primary amino compounds. This coloration might be an appropriate marker to substantiate if coffee seeds had been stored for an expanded time and putative quality losses were not relevant so far.\${\textbackslash}backslash\$n\${\textbackslash}backslash\$nCONCLUSIONS: It is suggested that loss of viability is relevant for the aroma flattening. As neither metabolic nor post-mortem reactions were responsible for the observed changes, it is concluded that Maillard reactions that occur during storage might be the cause of the decrease in potential aroma precursors.},
	number = {1},
	journal = {Annals of Botany},
	author = {Selmar, Dirk and Bytof, Gerhard and Knopp, Sven Erik},
	year = {2008},
	pmid = {17981880},
	keywords = {Post-harvest treatment, Coffee processing, Coffea arabica, Storage, Loss of viability, Viridinic acid},
	pages = {31--38},
	file = {Full Text PDF:/home/rob/Zotero/storage/AZQCWETB/Selmar et al. - 2008 - The Storage of Green Coffee (Coffea arabica) Decr.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/KJJLS4H5/92513.html:text/html},
}

