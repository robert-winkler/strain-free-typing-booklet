	volume = {27},
	issn = {1879-1123},
	shorttitle = {{DetectTLC}},
	url = {https://doi.org/10.1007/s13361-015-1293-9},
	doi = {10.1007/s13361-015-1293-9},
	abstract = {Full characterization of complex reaction mixtures is necessary to understand mechanisms, optimize yields, and elucidate secondary reaction pathways. Molecular-level information for species in such mixtures can be readily obtained by coupling mass spectrometry imaging (MSI) with thin layer chromatography (TLC) separations. User-guided investigation of imaging data for mixture components with known m/z values is generally straightforward; however, spot detection for unknowns is highly tedious, and limits the applicability of MSI in conjunction with TLC. To accelerate imaging data mining, we developed DetectTLC, an approach that automatically identifies m/z values exhibiting TLC spot-like regions in MS molecular images. Furthermore, DetectTLC can also spatially match m/z values for spots acquired during alternating high and low collision-energy scans, pairing product ions with precursors to enhance structural identification. As an example, DetectTLC is applied to the identification and structural confirmation of unknown, yet significant, products of abiotic pyrazinone and aminopyrazine nucleoside analog synthesis. Open image in new window Graphical Abstract ᅟ},
	language = {en},
	number = {2},
	urldate = {2020-01-13},
	journal = {J. Am. Soc. Mass Spectrom.},
	author = {Kaddi, Chanchala D. and Bennett, Rachel V. and Paine, Martin R. L. and Banks, Mitchel D. and Weber, Arthur L. and Fernández, Facundo M. and Wang, May D.},
	month = feb,
	year = {2016},
	keywords = {Ambient MS, Data processing, DESI MS, Feature detection, Imaging mass spectrometry},
	pages = {359--365},
	file = {Springer Full Text PDF:/home/rob/Zotero/storage/8HEGTBVG/Kaddi et al. - 2016 - DetectTLC Automated Reaction Mixture Screening Ut.pdf:application/pdf},
}

