	pages = {884--891},
	file = {ACS Full Text PDF w/ Links:/home/rob/Zotero/storage/88X5ZH4M/Benton et al. - 2015 - Autonomous Metabolomics for Rapid Metabolite Ident.pdf:application/pdf;ACS Full Text Snapshot:/home/rob/Zotero/storage/MRM4ZARH/ac5025649.html:text/html},
}

