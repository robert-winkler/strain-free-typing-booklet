	journal = {Current Proteomics},
	author = {Urban, Jan and Vanek, Jan and Stys, Dalibor},
	year = {2012},
	pages = {80--93},
}

@article{stanford_informed_2016,
	title = {Informed baseline subtraction of proteomic mass spectrometry data aided by a novel sliding window algorithm},
	volume = {14},
	issn = {1477-5956},
	url = {https://doi.org/10.1186/s12953-016-0107-8},
	doi = {10.1186/s12953-016-0107-8},
	abstract = {Proteomic matrix-assisted laser desorption/ionisation (MALDI) linear time-of-flight (TOF) mass spectrometry (MS) may be used to produce protein profiles from biological samples with the aim of discovering biomarkers for disease. However, the raw protein profiles suffer from several sources of bias or systematic variation which need to be removed via pre-processing before meaningful downstream analysis of the data can be undertaken. Baseline subtraction, an early pre-processing step that removes the non-peptide signal from the spectra, is complicated by the following: (i) each spectrum has, on average, wider peaks for peptides with higher mass-to-charge ratios (m/z), and (ii) the time-consuming and error-prone trial-and-error process for optimising the baseline subtraction input arguments. With reference to the aforementioned complications, we present an automated pipeline that includes (i) a novel ‘continuous’ line segment algorithm that efficiently operates over data with a transformed m/z-axis to remove the relationship between peptide mass and peak width, and (ii) an input-free algorithm to estimate peak widths on the transformed m/z scale.},
	language = {en},
	number = {1},
	urldate = {2023-02-09},
	journal = {Proteome Sci},
	author = {Stanford, Tyman E. and Bagley, Christopher J. and Solomon, Patty J.},
	month = dec,
	year = {2016},
	keywords = {Mass spectrometry, Time-of-flight, Baseline subtraction, Line segment algorithm, Mathematical morphology, Matrix-assisted laser desorption/ionization, Pre-processing, Top-hat operator, Unevenly spaced data},
	pages = {19},
	file = {Full Text PDF:/home/rob/Zotero/storage/4UU62ZHB/Stanford et al. - 2016 - Informed baseline subtraction of proteomic mass sp.pdf:application/pdf},
}

