	keywords = {Food safety, Authenticity, Adulteration, Biomarkers, Food fingerprints},
	pages = {144--162},
	file = {ScienceDirect Snapshot:/home/rob/Zotero/storage/8LNI6CFH/S0308814618319848.html:text/html},
}

@incollection{laursen_9_2016,
	series = {Woodhead {Publishing} {Series} in {Food} {Science}, {Technology} and {Nutrition}},
