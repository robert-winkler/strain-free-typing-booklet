	journal = {Sensors},
	author = {Alahi, Md Eshrat E. and Mukhopadhyay, Subhas Chandra},
	month = aug,
	year = {2017},
	note = {Number: 8
Publisher: Multidisciplinary Digital Publishing Institute},
	keywords = {pathogen, bacterial infection, biosensors, chemical sensors, endotoxin, smart sensors, toxin},
	pages = {1885},
	file = {Full Text PDF:/home/rob/Zotero/storage/74IQ436N/Alahi and Mukhopadhyay - 2017 - Detection Methodologies for Pathogen and Toxins A.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/CDW93AXW/1885.html:text/html;Snapshot:/home/rob/Zotero/storage/A4NJZI9K/1885.html:text/html},
