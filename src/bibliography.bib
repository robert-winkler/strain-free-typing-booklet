	pmid = {23788733},
	keywords = {Crops, Agricultural, Gene Expression Regulation, Plant, Gene Expression Profiling, Genes, Plant, Multigene Family, Lycopersicon esculentum, Gene Silencing, Nutritive Value, Solanaceous Alkaloids, Solanum tuberosum},
	pages = {175--179},
}

