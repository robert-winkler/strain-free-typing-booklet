	month = oct,
	year = {2010},
	pmid = {20493491},
	keywords = {Humans, Mass Spectrometry, Animals, Chromatography, Thin Layer, Biological Assay, Chromatography, High Pressure Liquid},
	pages = {6600--6609},
}

@incollection{morlock_planar_2014,
