	pages = {3972},
	file = {Full Text PDF:/home/rob/Zotero/storage/GUG8RQ3A/Creydt and Fischer - 2020 - Food Phenotyping Recording and Processing of Non-.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/BSY2KRLE/3972.html:text/html},
