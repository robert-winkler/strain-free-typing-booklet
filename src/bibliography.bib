	pages = {103--121},
	file = {Full Text PDF:/home/rob/Zotero/storage/Q4RIAFKA/Bertram and Hanson - 2001 - Animal models and programming of the metabolic syn.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/P92I42IX/103.html:text/html},
}

@incollection{lawson_chapter_2013,
	address = {Boston},
	title = {Chapter 11 - {Animal} {Models} of {Metabolic} {Syndrome} {A2}  - {Conn}, {P}. {Michael}},
	isbn = {978-0-12-415894-8},
	url = {http://www.sciencedirect.com/science/article/pii/B9780124158948000117},
	abstract = {Metabolic syndrome (MetS) is a clustering of metabolic complications representing a pre-morbid condition that is a substantial public health burden. Animal models provide an opportunity to examine correlations among different metabolic parameters to understand why metabolic complications sometimes cluster and sometimes do not. This chapter provides an overview of animal models of MetS that are used to understand etiology and pathophysiology, with a focus on methods of identifying and testing candidate genes with the aim of translating results to human studies. Genetic, epigenetic, environmental, and gene by environmental methods and results are discussed along with important lessons learned. Rodent models are the most frequently used, however other animal models including dogs, pigs, sheep, and non-human primates have contributed to our understanding of MetS and each are discussed. Additionally, animal models used to test physiological hypotheses are reviewed along with their potential to illuminate DNA sequence–metabolic function relationships to inform therapies.},
	urldate = {2016-05-04},
	booktitle = {Animal {Models} for the {Study} of {Human} {Disease}},
	publisher = {Academic Press},
	author = {Lawson, Heather A.},
	year = {2013},
	keywords = {insulin resistance, Obesity, metabolic syndrome, Candidate genes, Dislipidemia, Environment, Epigenetics, Interaction, Pathophysiology, Quantitative trait loci (QTL)},
	pages = {243--264},
	file = {ScienceDirect Full Text PDF:/home/rob/Zotero/storage/C3SHDMZS/Lawson - 2013 - Chapter 11 - Animal Models of Metabolic Syndrome A.pdf:application/pdf;ScienceDirect Snapshot:/home/rob/Zotero/storage/2GUFDIM5/B9780124158948000117.html:text/html},
}

