@article{laye_effects_2015,
	title = {The effects of age and dietary restriction on the tissue-specific metabolome of {Drosophila}},
	volume = {14},
	copyright = {© 2015 The Authors. Aging Cell published by the Anatomical Society and John Wiley \& Sons Ltd., This is an open access article under the terms of the Creative Commons Attribution License, which permits use, distribution and reproduction in any medium, provided the original work is properly cited.},
	issn = {1474-9726},
	url = {http://onlinelibrary.wiley.com/doi/10.1111/acel.12358/abstract},
	doi = {10.1111/acel.12358},
	abstract = {Dietary restriction (DR) is a robust intervention that extends lifespan and slows the onset of age-related diseases in diverse organisms. While significant progress has been made in attempts to uncover the genetic mechanisms of DR, there are few studies on the effects of DR on the metabolome. In recent years, metabolomic profiling has emerged as a powerful technology to understand the molecular causes and consequences of natural aging and disease-associated phenotypes. Here, we use high-resolution mass spectroscopy and novel computational approaches to examine changes in the metabolome from the head, thorax, abdomen, and whole body at multiple ages in Drosophila fed either a nutrient-rich ad libitum (AL) or nutrient-restricted (DR) diet. Multivariate analysis clearly separates the metabolome by diet in different tissues and different ages. DR significantly altered the metabolome and, in particular, slowed age-related changes in the metabolome. Interestingly, we observed interacting metabolites whose correlation coefficients, but not mean levels, differed significantly between AL and DR. The number and magnitude of positively correlated metabolites was greater under a DR diet. Furthermore, there was a decrease in positive metabolite correlations as flies aged on an AL diet. Conversely, DR enhanced these correlations with age. Metabolic set enrichment analysis identified several known (e.g., amino acid and NAD metabolism) and novel metabolic pathways that may affect how DR effects aging. Our results suggest that network structure of metabolites is altered upon DR and may play an important role in preventing the decline of homeostasis with age.},
	language = {en},
	number = {5},
	urldate = {2015-10-23},
	journal = {Aging Cell},
	author = {Laye, Matthew J. and Tran, ViLinh and Jones, Dean P. and Kapahi, Pankaj and Promislow, Daniel E. L.},
	month = oct,
	year = {2015},
	keywords = {Metabolome, Metabolomics, Bioinformatics, Drosophila, Aging, dietary restriction},
	pages = {797--808},
	file = {Full Text PDF:/home/rob/Zotero/storage/DZRVBUII/Laye et al. - 2015 - The effects of age and dietary restriction on the .pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/XCMGCA9E/full.html:text/html},
}

@article{markow_secret_2015,
	title = {The secret lives of {Drosophila} flies},
	volume = {4},
	copyright = {© 2015, Markow. This article is distributed under the terms of the Creative Commons Attribution License, which permits unrestricted use and redistribution provided that the original author and source are credited.},
	issn = {2050-084X},
	url = {http://elifesciences.org/content/4/e06793},
	doi = {10.7554/eLife.06793},
	abstract = {Flies of the genus Drosophila, and particularly those of the species Drosophila melanogaster, are best known as laboratory organisms. As with all model organisms, they were domesticated for empirical studies, but they also continue to exist as wild populations.Decades of research on these flies in the laboratory have produced astounding and important insights into basic biological processes, but we have only scratched the surface of what they have to offer as research organisms. An outstanding challenge now is to build on this knowledge and explore how natural history has shaped D. melanogaster in order to advance our understanding of biology more generally.DOI: http://dx.doi.org/10.7554/eLife.06793.001View Full TextTo Top
Flies of the genus Drosophila, and particularly those of the species Drosophila melanogaster, are best known as laboratory organisms. As with all model organisms, they were domesticated for empirical studies, but they also continue to exist as wild populations.
Decades of research on these flies in the laboratory have produced astounding and important insights into basic biological processes, but we have only scratched the surface of what they have to offer as research organisms. An outstanding challenge now is to build on this knowledge and explore how natural history has shaped D. melanogaster in order to advance our understanding of biology more generally.
DOI: http://dx.doi.org/10.7554/eLife.06793.001},
	language = {en},
	urldate = {2015-10-18},
