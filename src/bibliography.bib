	volume = {23},
	copyright = {Copyright (c)},
	issn = {2659-1502},
	url = {https://www.ajol.info/index.php/jasem/article/view/187587},
	doi = {10.4314/jasem.v23i5.21},
	abstract = {This study examined cassava yield response to variable climate in the humid forest agro-ecological zone of Nigeria. The data employed for this study was sourced from the archives of Nigeria Meteorological Agency, Lagos State and Ogun State Agricultural Development Program, Abeokuta. Bivariate correlation, multiple regression and Z-distribution were employed for data analysis. Results show that monthly, seasonal and annual rainfall did not affect the yield of cassava but monthly, seasonal and annual minimum and maximum temperature was significantly related to cassava yield at p ≤ 0.05. Non-climatic factors have a greater influence on cassava yield than climatic factors in the study area. Nevertheless, climatic factors influenced cassava yield more at Abeokuta than Ijebu-Ode. Cassava yield was lower from 1987-1993 (with negative significant impact in 1987 and 1988 at p ≤ 0.01) than 1994-2012. These results demonstrated that climate variability needs to be taken into account in cassava impact assessment.Keywords: cassava yield, impact, climate variability, rainfall, temperature},
	language = {en},
	number = {5},
