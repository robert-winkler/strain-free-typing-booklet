	month = aug,
	year = {2016},
	pmid = {26947242},
	keywords = {Mass Spectrometry, Proteomics, Crops, Agricultural, Mass spectrometry, Data processing, Peptides, Plant Proteins, Statistics, Peptide},
	pages = {883--895},
}

