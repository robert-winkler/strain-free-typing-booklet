	number = {3},
	journal = {Vet. Ital.},
	author = {Colangeli, Patrizia and Ferrilli, Monica and Quaranta, Fabrizio and Malizia, Elio and Mbulu, Rosa-Stella and Mukete, Esther and Iipumbu, Lukas and Kamhulu, Anna and Tjipura-Zaire, Georgina and Di Francesco, Cesare and Lelli, Rossella and Scacchia, Massimo},
