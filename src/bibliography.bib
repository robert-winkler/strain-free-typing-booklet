@article{laroussi_inactivation_2006,
	title = {Inactivation of {Bacteria} by the {Plasma} {Pencil}},
	volume = {3},
	copyright = {Copyright © 2006 WILEY-VCH Verlag GmbH \& Co. KGaA, Weinheim},
