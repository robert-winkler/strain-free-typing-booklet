	file = {Full Text PDF:/home/rob/Zotero/storage/YVSAMF2G/Roach et al. - 2010 - Nanospray desorption electrospray ionization an a.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/QT6MYCJ9/C0AN00312C.html:text/html;Snapshot:/home/rob/Zotero/storage/GGH2B4JP/unauth.html:text/html},
}

