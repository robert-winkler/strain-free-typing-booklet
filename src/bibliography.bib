@article{lopez_tequilas:_2001,
	title = {Tequilas: {Charm} analysis of {Blanco}, {Reposado}, and {Anejo} tequilas},
	volume = {782},
	issn = {00976156},
	abstract = {Tequila is a Mexican alc. beverage obtained from Agave tequilana Weber var. azul that requires from 8 to 12 yr to mature. Traditionally, raw agave pines are cooked, fermented, and double distd. to produce Blanco, Reposado, and Anejo tequilas. Recently, some important tequila flavor components have been published. The main aims of this study were to establish the differences among the 3 tequila types and to det. the most potent odorants in each type by gas chromatog.-olfactometry. Tequila exts. were obtained by liq.-liq. extn. with dichloromethane. Fifth diln. series was used to det. the charm values. Qual. and quant. differences were obsd. in all tequilas. The most potent odorants were phenylethanol and phenylethyl acetate in Blanco tequila; phenylethanol, phenylethyl acetate, and vanillin in Reposado tequila; and phenylethanol, vanillin, and an unknown in Anejo tequila. A good correlation was found between flavor compds. and the aging process of tequilas in white oak casks},
	journal = {Gas Chromatography-Olfactometry},
	author = {Lopez, M G and Dufour, J P},
	year = {2001},
	note = {bibtex: Lopez2001},
	keywords = {analysis, GC-MS, volatile compounds, A, agave tequilana, aging, CHARM, correlation, DIFFERENCE, FLAVOR, flavour, Gas Chromatography-Olfactometry, gc, GC-O, odourants, pine, study, tequila, vanillin, volatile composition},
	pages = {63--72},
}

@article{lachenmeier_quantification_2006,
	title = {Quantification of selected volatile constituents and anions in {Mexican} {Agave} spirits ({Tequila}, {Mezcal}, {Sotol}, {Bacanora})},
	volume = {54},
	issn = {00218561},
	url = {http://pubs.acs.org/doi/abs/10.1021/jf060094h},
	doi = {10.1021/jf060094h},
	abstract = {A large collection (n = 95) of Mexican Agave spirits with protected appellations of origin (Tequila, Mezcal, Sotol, and Bacanora) was analyzed using ion and gas chromatography. Because of their production from oxalate-containing plant material, all Agave spirits contained significant concentrations of oxalate (0.1-9.7 mg/L). The two Tequila categories ("100\% Agave" and "mixed") showed differences in the methanol, 2-/3-methyl-1-butanol, and 2-phenylethanol concentrations with lower concentrations in the mixed category. Mezcal showed no significant differences in any of the evaluated parameters that would allow a classification. Sotol showed higher nitrate concentrations and lower 2-/3-methyl-1-butanol concentrations. Bacanora was characterized by exceptionally high acetaldehyde concentrations and a relatively low ethyl lactate content. The methanol content was the most problematic compound regarding the Mexican standards: two Tequilas (4\%), five Sotols (31\%), and six Bacanoras (46\%) had levels above the maximum methanol content of 300 g/hL of alcohol. In conclusion, the composition of Mexican Agave spirits was found to vary over a relatively large range.},
	number = {11},
	journal = {Journal of Agricultural and Food Chemistry},
	author = {Lachenmeier, Dirk W. and Sohnius, Eva Maria and Attig, Rainer and López, Mercedes G.},
	year = {2006},
	pmid = {16719514},
	note = {bibtex: Lachenmeier2006 },
	keywords = {volatile compounds, Agave, tequila, Agavaceae, Bacanora, Gas chromatography, Ion chromatography, Mezcal, Sotol},
	pages = {3911--3915},
}

