	file = {Full Text PDF:/home/rob/Zotero/storage/FKWPKYNM/Wright et al. - 2005 - The Effects of Artificial Selection on the Maize G.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/6WR8YXA4/1310.html:text/html},
