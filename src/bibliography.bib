@article{jeffryes_mines_2015,
	title = {{MINEs}: open access databases of computationally predicted enzyme promiscuity products for untargeted metabolomics},
	volume = {7},
	issn = {1758-2946},
	shorttitle = {{MINEs}},
	url = {https://doi.org/10.1186/s13321-015-0087-1},
	doi = {10.1186/s13321-015-0087-1},
	abstract = {In spite of its great promise, metabolomics has proven difficult to execute in an untargeted and generalizable manner. Liquid chromatography–mass spectrometry (LC–MS) has made it possible to gather data on thousands of cellular metabolites. However, matching metabolites to their spectral features continues to be a bottleneck, meaning that much of the collected information remains uninterpreted and that new metabolites are seldom discovered in untargeted studies. These challenges require new approaches that consider compounds beyond those available in curated biochemistry databases.},
	language = {en},
	number = {1},
