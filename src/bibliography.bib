	pmid = {22842151},
	keywords = {Mass Spectrometry, Software, Automatic Data Processing, Data Interpretation, Statistical, Databases, Protein, Diagnostic Imaging, Information Dissemination, Information Storage and Retrieval, Models, Biological, User-Computer Interface},
	pages = {5106--5110},
}

