@article{kang_acr_2018,
	title = {{ACR} {Appropriateness} {Criteria} ® {Staging} and {Follow}-{Up} of {Ovarian} {Cancer}},
	volume = {15},
	issn = {15461440},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S1546144018303430},
	doi = {10.1016/j.jacr.2018.03.015},
	abstract = {In the management of epithelial ovarian cancers, imaging is used for cancer detection and staging, both before and after initial treatment. The decision of whether to pursue initial cytoreductive surgery for ovarian cancer depends in part on accurate staging. Contrast-enhanced CT of the abdomen and pelvis (and chest where indicated) is the current imaging modality of choice for the initial staging evaluation of ovarian cancer. Fluorine-18-2-ﬂuoro-2-deoxy-D-glucose PET/CT and MRI may be appropriate for problem-solving purposes, particularly when lesions are present on CT but considered indeterminate. In patients who achieve remission, clinical suspicion for relapse after treatment prompts imaging evaluation for recurrence. Contrast-enhanced CT is the modality of choice to assess the extent of recurrent disease, and ﬂuorine-18-2-ﬂuoro-2deoxy-D-glucose PET/CT is also usually appropriate, as small metastatic foci may be identiﬁed. If imaging or clinical examination conﬁrms a recurrence, the extent of disease and timing of disease recurrence then determines the choice of treatments, including surgery, chemotherapy, and radiation therapy.},
	language = {en},
	number = {5},
	urldate = {2022-01-09},
	journal = {Journal of the American College of Radiology},
	author = {Kang, Stella K. and Reinhold, Caroline and Atri, Mostafa and Benson, Carol B. and Bhosale, Priyadarshani R. and Jhingran, Anuja and Lakhman, Yulia and Maturen, Katherine E. and Nicola, Refky and Pandharipande, Pari V. and Salazar, Gloria M. and Shipp, Thomas D. and Simpson, Lynn and Small, William and Sussman, Betsy L. and Uyeda, Jennifer W. and Wall, Darci J. and Whitcomb, Bradford P. and Zelop, Carolyn M. and Glanc, Phyllis},
	month = may,
	year = {2018},
	pages = {S198--S207},
}

@article{cardi_prognostic_2019,
	title = {Prognostic {Factors} {Influencing} {Infectious} {Complications} after {Cytoreductive} {Surgery} and {HIPEC}: {Results} from a {Tertiary} {Referral} {Center}},
	volume = {2019},
	issn = {1687-6121, 1687-630X},
	shorttitle = {Prognostic {Factors} {Influencing} {Infectious} {Complications} after {Cytoreductive} {Surgery} and {HIPEC}},
	url = {https://www.hindawi.com/journals/grp/2019/2824073/},
	doi = {10.1155/2019/2824073},
	abstract = {Background
. Cytoreductive surgery (CRS) and hyperthermic intraperitoneal chemotherapy (HIPEC) showed promising results in selected patients. High morbidity restrains its wide application. The aim of this study was to report postoperative infectious complications and investigate possible correlations with the preoperative nutritional status and other prognostic factors in patients with peritoneal metastases treated with CRS and HIPEC.
Methods
. For the study, we reviewed the clinical records of all patients with peritoneal metastases from different primary cancers treated with CRS and HIPEC in our Institution from November 2000 to December 2017. Patients were divided according to their nutritional status (SGA) into groups A (well-nourished) and B/C (mild or severely malnourished, respectively). Possible statistical correlations between risk factors and postoperative complication rates have been investigated by univariate and multivariate analysis.
Results
. Two hundred patients were selected and underwent CRS and HIPEC during the study period. Postoperative complications occurred in 44\% of the patients, 35.3\% in SGA-A patients, and 53\% in SGA-B/C patients. Cause of complications was infective in 42, noninfective in 37, and HIPEC related in 9 patients. Infectious complications occurred more frequently in SGA-B/C patients (32.6\% vs. 9.8\% of SGA-A patients). The most frequent sites of infection were surgical site infections (SSI, 35.7\%) and central line-associated bloodstream infections (CLABSI, 26.2\%). The most frequent isolated species was Candida (22.8\%). ASA score, blood loss, performance status, PCI, large bowel resection, postoperative serum albumin levels, and nutritional status correlated with higher risk for postoperative infectious complications.
Conclusions
. Malnourished patients undergoing cytoreductive surgery and hyperthermic intraperitoneal chemotherapy are more prone to postoperative infectious complications, and adequate perioperative nutritional support should be considered, including immune-enhancing nutrition. Sequential monitoring of common sites of infection, antifungal prevention of candidiasis, and careful patient selection should be implemented to reduce the complication rate.},
	language = {en},
	urldate = {2022-01-09},
	journal = {Gastroenterology Research and Practice},
	author = {Cardi, Maurizio and Sibio, Simone and Di Marzo, Francesco and Lefoche, Francesco and d’Agostino, Claudia and Fonsi, Giovanni Battista and La Torre, Giuseppe and Carbonari, Ludovica and Sammartino, Paolo},
	month = may,
	year = {2019},
	pages = {1--8},
}

