@article{norgaard_study_2013,
	title = {Study of ozone-initiated limonene reaction products by low temperature plasma ionization mass spectrometry},
	volume = {24},
	issn = {1879-1123},
	doi = {10.1007/s13361-013-0648-3},
	abstract = {Limonene and its ozone-initiated reaction products were investigated in situ by low temperature plasma (LTP) ionization quadrupole time-of-flight (QTOF) mass spectrometry. Helium was used as discharge gas and the protruding plasma generated {\textasciitilde}850 ppb ozone in front of the glass tube by reaction with the ambient oxygen. Limonene applied to filter paper was placed in front of the LTP afterglow and the MS inlet. Instantly, a wide range of reaction products appeared, ranging from m/z 139 to ca. 1000 in the positive mode and m/z 115 to ca. 600 in the negative mode. Key monomeric oxidation products including levulinic acid, 4-acetyl-1-methylcyclohexene, limonene oxide, 3-isopropenyl-6-oxo-heptanal, and the secondary ozonide of limonene could be identified by collision-induced dissociation. Oligomeric products ranged from the nonoxidized dimer of limonene (C20H30) and up to the hexamer with 10 oxygen atoms (C60H90O10). The use of LTP for in situ ozonolysis and ionization represents a new and versatile approach for the assessment of ozone-initiated terpene chemistry.},
	language = {eng},
	number = {7},
	journal = {J. Am. Soc. Mass Spectrom.},
	author = {Nørgaard, Asger W. and Vibenholt, Anni and Benassi, Mario and Clausen, Per Axel and Wolkoff, Peder},
	month = jul,
	year = {2013},
	pmid = {23666602},
	note = {00016 },
	keywords = {Proteomics, Ambient mass spectrometry, Bioinformatics, Low temperature plasma, Analytical Chemistry, Biotechnology, Organic Chemistry, ambient mass, limonene oxidation products, Limonene oxidation products, low temperature plasma, ozonolysis of limonene, Ozonolysis of limonene},
	pages = {1090--1096},
	file = {Full Text PDF:/home/rob/Zotero/storage/H7HI5UQS/Nørgaard et al. - Study of Ozone-Initiated Limonene Reaction Product.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/WK7U2IWB/s13361-013-0648-3.html:text/html},
