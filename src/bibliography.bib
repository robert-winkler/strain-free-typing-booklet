@article{venter_mechanisms_2014,
	title = {Mechanisms of real-time, proximal sample processing during ambient ionization mass spectrometry},
	volume = {86},
	issn = {0003-2700},
	doi = {10.1021/ac4038569},
	abstract = {In this review we highlight the general change in perception in the field that it is the immediacy of sample preparation which truly differentiates the ambient analysis methods from direct mass spectrometric analysis. Ambient analysis methods represent novel application of sample processing which takes place in real time and proximal to ionization, while ionization for the most takes place through well known processes. In order to do so mechanisms of analyte processing is reviewed in detail, as it pertains to ambient analysis and ionization is mentioned to point out aspects particular to ambient analysis. A more inclusive historical approach was needed to fully describe the mechanisms of processing.},
	number = {1},
	journal = {Analytical Chemistry},
	author = {Venter, Andre R. and Douglass, Kevin A. and Shelley, Jacob T. and Hasman, Gregg and Honarvar, Elahe},
	year = {2014},
	pages = {233--249},
}

