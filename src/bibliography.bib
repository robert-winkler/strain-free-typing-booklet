}

@article{salimi_contaminants_2017,
	title = {Contaminants of emerging concern: a review of new approach in {AOP} technologies},
	volume = {189},
	issn = {1573-2959},
	shorttitle = {Contaminants of emerging concern},
	url = {https://doi.org/10.1007/s10661-017-6097-x},
	doi = {10.1007/s10661-017-6097-x},
	abstract = {The presence of contaminants of emerging concern (CECs) such as pharmaceuticals and personal care products (PPCPs), endocrine-disrupting compounds (EDCs), flame retardants (FRs), pesticides, and artificial sweeteners (ASWs) in the aquatic environments remains a major challenge to the environment and human health. In this review, the classification and occurrence of emerging contaminants in aquatic environments were discussed in detail. It is well documented that CECs are susceptible to poor removal during the conventional wastewater treatment plants, which introduce them back to the environment ranging from nanogram per liter (e.g., carbamazepine) up to milligram per liter (e.g., acesulfame) concentration level. Meanwhile, a deep insight into the application of advanced oxidation processes (AOPs) on mitigation of the CECs from aquatic environment was presented. In this regard, the utilization of various treatment technologies based on AOPs including ozonation, Fenton processes, sonochemical, and TiO2 heterogeneous photocatalysis was reviewed. Additionally, some innovations (e.g., visible light heterogeneous photocatalysis, electro-Fenton) concerning the AOPs and the combined utilization of AOPs (e.g., sono-Fenton) were documented.},
	language = {en},
	number = {8},
	urldate = {2020-12-11},
	journal = {Environ Monit Assess},
	author = {Salimi, Maryam and Esrafili, Ali and Gholami, Mitra and Jonidi Jafari, Ahmad and Rezaei Kalantary, Roshanak and Farzadkia, Mahdi and Kermani, Majid and Sobhi, Hamid Reza},
	month = jul,
	year = {2017},
	pages = {414},
	file = {Springer Full Text PDF:/home/rob/Zotero/storage/Q2Z3J94E/Salimi et al. - 2017 - Contaminants of emerging concern a review of new .pdf:application/pdf},
}

