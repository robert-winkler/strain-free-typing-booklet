	pages = {159--160},
	file = {Full Text PDF:/home/rob/Zotero/storage/G6SM983C/Radick - 2015 - Beyond the “Mendel-Fisher controversy”.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/ZICPSH4G/159.html:text/html},
}

@book{franklin_ending_2008,
	address = {Pittsburgh, PA},
	title = {Ending the {Mendel}-{Fisher} {Controversy}},
	isbn = {978-0-8229-5986-1},
	abstract = {In 1865, Gregor Mendel presented “Experiments in Plant-Hybridization,” the results of his eight-year study of the principles of inheritance through experimentation with pea plants. Overlooked in its day, Mendel's work would later become the foundation of modern genetics. Did his pioneering research follow the rigors of real scientific inquiry, or was Mendel's data too good to be true-the product of doctored statistics? In Ending the Mendel-Fisher Controversy, leading experts present their conclusions on the legendary controversy surrounding the challenge to Mendel's findings by British statistician and biologist R. A. Fisher. In his 1936 paper “Has Mendel's Work Been Rediscovered?” Fisher suggested that Mendel's data could have been falsified in order to support his expectations. Fisher attributed the falsification to an unknown assistant of Mendel's. At the time, Fisher's criticism did not receive wide attention. Yet beginning in 1964, about the time of the centenary of Mendel's paper, scholars began to publicly discuss whether Fisher had successfully proven that Mendel's data was falsified. Since that time, numerous articles, letters, and comments have been published on the controversy.This self-contained volume includes everything the reader will need to know about the subject: an overview of the controversy; the original papers of Mendel and Fisher; four of the most important papers on the debate; and new updates, by the authors, of the latter four papers. Taken together, the authors contend, these voices argue for an end to the controversy-making this book the definitive last word on the subject.},
	language = {English},
	publisher = {University of Pittsburgh Press},
	author = {Franklin, Allan and Edwards, A. W. F. and Fairbanks, Daniel J. and Hartl, Daniel L. and Seidenfeld, Teddy},
	month = mar,
	year = {2008},
}

