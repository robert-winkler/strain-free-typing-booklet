	editor = {Baluška, František},
	year = {2013},
	doi = {10.1007/978-3-642-36470-9_17},
	keywords = {Jasmonic acid, Electrical signals, Herbivory, Hydraulic signals, Peps, Phytohormones, Plant Biochemistry, Plant Genetics \& Genomics, Plant Pathology, Plant Physiology, ROS, Systemic signaling, Systemins, volatiles},
	pages = {323--362},
