	volume = {31},
	issn = {0963-9969},
	url = {http://www.sciencedirect.com/science/article/pii/S0963996999000162},
	doi = {10.1016/S0963-9969(99)00016-2},
	abstract = {The lipids of crude coffee beans of Catuaı́ Vermalho, Coffea arabica L. harvested in Brazil have been examined as a part of a broader program on their role for the quality of Brazilian coffee. Triacylglycerols (75\%), terpene esters (14\%), partial acylglycerols (5\%), free fatty acids (1\%), free sterols (1.5\%), sterol esters (1\%) and polar lipids ({\textless}1\%) were detected in the lipid extract. Sitosterol was the main component of free sterols. Ten fatty acids, 14:0, 16:0, 16:1, 18:0, 18:1, 18:2, 18:3, 20:0, 20:1 and 22:0, were identified and their specific distribution between the lipid classes determined. Saturated fatty acids dominated the terpene- and sterol esters, while unsaturated fatty acids prevailed in triacylglycerols and free fatty acids. Triacylglycerol composition of Brazilian coffee beans is reported for the first time. Twenty-eight triacylglycerol molecular species were identified and quantified by successive applications of silver ion- and reversed phase thin-layer chromatography. Dipalmitolinolein (24\%). dilinoleopalmitin (13\%) and palmitoleolinolein (11\%) were the main components ©},
	number = {6},
	urldate = {2018-10-24},
	journal = {Food Research International},
	author = {Nikolova-Damyanova, B. and Velikova, R. and Jham, Gulab N.},
	month = aug,
	year = {1998},
	keywords = {Fatty acids, Brazilian coffee, fatty acids, lipid classes, Lipid classes, triacylglycerols, Triacylglycerols},
	pages = {479--486},
	file = {ScienceDirect Full Text PDF:/home/rob/Zotero/storage/H7TV7C8G/Nikolova-Damyanova et al. - 1998 - Lipid classes, fatty acid composition and triacylg.pdf:application/pdf;ScienceDirect Snapshot:/home/rob/Zotero/storage/QHAPHB2K/S0963996999000162.html:text/html},
}

