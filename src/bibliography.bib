	keywords = {Food Analysis, Humans, Mass Spectrometry, Spectrometry, Mass, Matrix-Assisted Laser Desorption-Ionization, Animals, Spectrometry, Mass, Electrospray Ionization, Amino Acid Sequence, Molecular Sequence Data, Dietary Proteins, Peptides, Spectrometry, Mass, Fast Atom Bombardment},
	pages = {981--994},
}

