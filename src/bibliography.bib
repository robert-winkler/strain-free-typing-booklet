	keywords = {bit depth, grayscale resolution, GSDF, human visual system, Medical display, shades of gray},
	pages = {422--432},
	file = {Springer Full Text PDF:/home/rob/Zotero/storage/XH4AWWWW/Kimpe and Tuytschaever - 2007 - Increasing the Number of Gray Shades in Medical Di.pdf:application/pdf},
}

