@article{liao_optimizing_2010,
	title = {Optimizing the {Conditions} of a {Multiple} {Reaction} {Monitoring} {Assay} for {Membrane} {Proteins}: {Quantification} of {Cytochrome} {P450} {11A1} and {Adrenodoxin} {Reductase} in {Bovine} {Adrenal} {Cortex} and {Retina}},
