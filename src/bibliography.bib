	author = {Patrie, Steven M.},
	year = {2016},
	pmid = {27975217},
	keywords = {Humans, Mass Spectrometry, Proteomics, Mass spectrometry, Animals, Chromatography, Databases, Protein, Alternative splicing, Bottom-up, Charge reduction, Computational Biology, Data-dependent, Data-independent, Electrospray ionization, Fourier transform, FT-ICR, High-Throughput Screening Assays, Hydrogen/deuterium exchange, Informatics, Label-free quantitation, Membrane proteins, Native MS, Orbitrap, Post-translational modifications, Protein, Proteins, Proteoform, Proteome, Quadrupole ion trap, Reversed-phase, Review, SILAC, SNPs, Supercharging, Tandem MS, Time-of-flight, Top-down, Workflow},
	pages = {171--200},
}

@article{ghaste_applications_2016,
	title = {Applications of {Fourier} {Transform} {Ion} {Cyclotron} {Resonance} ({FT}-{ICR}) and {Orbitrap} {Based} {High} {Resolution} {Mass} {Spectrometry} in {Metabolomics} and {Lipidomics}},
