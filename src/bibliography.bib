	volume = {85},
	issn = {0003-2700},
	url = {http://dx.doi.org/10.1021/ac401359k},
	doi = {10.1021/ac401359k},
	abstract = {A novel ambient ionization technique for mass spectrometry, microfabricated glow discharge plasma (MFGDP), is reported. This device is made of a millimeter-sized ceramic cavity with two platinum electrodes positioned face-to-face. He or Ar plasma can be generated by a direct current voltage of several hundreds of volts requiring a total power below 4 W. The thermal plume temperature of the He plasma was measured and found to be between 25 and 80 °C at a normal discharge current. Gaseous, liquid, creamy, and solid samples with molecular weights up to 1.5 kDa could be examined in both positive and negative mode, giving limits of detection (LOD) at or below the fg/mm2 level. The relative standard deviation (RSD) of manual sampling ranged from 10\% to ?20\%, while correlation coefficients of the working curve (R2) are all above 0.98 with the addition of internal standards. The ionization mechanisms are examed via both optical and mass spectrometry. Due to the low temperature characteristics of the microplasma, nonthermal momentum desorption is considered to dominate the desorption process.},
	number = {19},
	urldate = {2013-10-04},
	journal = {Anal. Chem.},
	author = {Ding, Xuelu and Zhan, Xuefang and Yuan, Xin and Zhao, Zhongjun and Duan, Yixiang},
	month = oct,
	year = {2013},
	pages = {9013--9020},
	file = {ACS Full Text PDF w/ Links:/home/rob/Zotero/storage/MBCUP7DI/Ding et al. - 2013 - Microfabricated Glow Discharge Plasma (MFGDP) for .pdf:application/pdf;ACS Full Text Snapshot:/home/rob/Zotero/storage/8H4HJHCA/ac401359k.html:text/html},
}

