	keywords = {Mineral oil, Batching oil (jute), Coupled LC-GC, Food contamination by hydrocarbons, Group-type analysis},
	pages = {33--39},
	file = {Snapshot:/home/rob/Zotero/storage/4GZCHMR8/jhrc.html:text/html},
}

