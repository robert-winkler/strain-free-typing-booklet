	pages = {291--297},
	file = {Full Text PDF:/home/rob/Zotero/storage/SXEXXMT8/Dickinson et al. - 2012 - The current state of citizen science as a tool for.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/A6K3BCST/110236.html:text/html},
}

