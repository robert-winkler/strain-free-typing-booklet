}

@article{bell_penning_1968,
	title = {Penning ionization by metastable helium atoms},
	volume = {1},
	issn = {0022-3700},
	url = {http://stacks.iop.org/0022-3700/1/i=1/a=303},
	abstract = {Values of the van der Waals interaction between the 2 1 S and 2 3 S metastable states of helium and
the systems Ne, Ar, Kr, Xe, H 2 , N 2 , O 2 , CH 4 , Li, Na, K, Rb, Cs and O are computed. The
