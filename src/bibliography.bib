}

@article{bratty_metabolomic_2011,
	title = {Metabolomic profiling of the effects of allopurinol on {Drosophila} melanogaster},
	volume = {7},
	issn = {1573-3882, 1573-3890},
	url = {http://link.springer.com/article/10.1007/s11306-011-0275-6},
	doi = {10.1007/s11306-011-0275-6},
	abstract = {Metabolomic profiling using hydrophilic interaction chromatography in combination with Fourier transform mass spectrometry was used to study the effects of the xanthine oxidase inhibitor allopurinol on wild type Drosophila melanogaster. Allopurinol treatment phenocopied the rosy mutation causing an elevation in the levels of xanthine and hypoxanthine and a fall in the levels of uric acid and allantoin. However, in addition there were some unexpected metabolic changes after treatment. Ascorbic acid levels were undetectable, glutathione levels fell and glutathione disulphide levels rose, methionine S-oxide levels rose and riboflavin levels fell. The origin of this oxidative stress was not immediately apparent; however, there was a strong suggestion that it might be related to a fall in NADPH levels linked to a reduction in glucose-6-phosphate dehydrogenase activity, resulting in reduced levels of some metabolites in the pentose phosphate pathway. In addition to producing oxidative stress there were marked effects on tryptophan metabolism with most of the metabolites in the kynurenine pathway being lowered by allopurinol treatment. The effects on the kynurenine pathway could be related to the established use of allopurinol in treating schizophrenia.},
	language = {en},
	number = {4},
	urldate = {2015-10-16},
	journal = {Metabolomics},
	author = {Bratty, Mohammed Al and Hobani, Yahya and Dow, Julian A. T. and Watson, David G.},
	month = jan,
	year = {2011},
	keywords = {Metabolomics, Drosophila, Biochemistry, general, Oxidative Stress, Biomedicine general, cell biology, Developmental Biology, Molecular Medicine, Fourier transform mass spectrometry, Allopurinol, Kynurenine pathway, Rosy},
	pages = {542--548},
	file = {Full Text PDF:/home/rob/Zotero/storage/F6EQESBU/Bratty et al. - 2011 - Metabolomic profiling of the effects of allopurino.pdf:application/pdf;Snapshot:/home/rob/Zotero/storage/8KWQV3PU/10.html:text/html},
}

@article{hariharan_invariance_2014,
	title = {Invariance and plasticity in the {Drosophila} melanogaster metabolomic network in response to temperature},
	volume = {8},
	copyright = {2015 Hariharan et al.; licensee BioMed Central.},
