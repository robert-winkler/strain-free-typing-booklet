	keywords = {Amino Acid Sequence, Molecular Sequence Data, Temperature, Water, Cell Wall, Plants, Genetically Modified, Peroxidases, Gene Expression Regulation, Enzymologic, Plants, Toxic, tobacco, Calorimetry, Differential Scanning, Germination, Osmosis},
	pages = {80--84},
}

